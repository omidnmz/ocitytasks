# From @BotFather in Telegram
TELEGRAM_BOT_TOKEN=
# Optional: your numeric Telegram chat id. If empty, the first person to send /start becomes the owner.
OWNER_CHAT_ID=
# Claude API key from https://platform.claude.com (without it, the bot runs with simple templates)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
TIMEZONE=Asia/Tehran
MORNING_TIME=10:30
EVENING_TIME=23:00
# Daily sweeps over today's tasks that have no time yet
CHECKIN_TIMES=14:00,20:00
# Content sprint follow-ups during the first 3 days
MISSION_FOLLOWUPS=12:30,17:00,21:30
# Busy shop hours: nudges falling here wait until the window ends, e.g. 18:30-20:00
QUIET_WINDOWS=
# Weekly content cycle: the day to get next week's handoff from Media Hub, and the batch filming days
PLAN_DAY=thursday
PRODUCTION_DAYS=saturday,tuesday
# Weekly review comes with the morning brief on this day
REVIEW_DAY=friday
# Buildings in the order you want to grow them (cityhall,retail,media,marketing,smarto,technician,fitness,tradebot,personal,vault)
BUILDING_PRIORITY=media,retail,smarto,marketing
DB_PATH=data/ocity.db
# Mini App (graphical city): the public https address that reaches this bot (see docs/mini-app.md)
WEBAPP_URL=
WEB_HOST=127.0.0.1
WEB_PORT=8080
